# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://127.0.0.1:5173

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full

# Authentication
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12

# Redis and BullMQ
REDIS_URL=rediss://default:PASSWORD@HOST:6379
BULL_BOARD_ENABLED=false
QUEUE_INVITATION_EMAIL_CONCURRENCY=2
QUEUE_TASK_REMINDER_CONCURRENCY=2
TASK_REMINDER_LEAD_MINUTES=60

# Invitations
WORKSPACE_INVITATION_TTL_HOURS=168

# Resend
RESEND_API_KEY=re_your_key
MAIL_FROM=TaskFlow <noreply@yourdomain.com>

# AWS S3
AWS_REGION=us-east-1
S3_TASK_IMAGES_BUCKET=your-task-images-bucket
S3_PRESIGNED_URL_TTL_SECONDS=900
TASK_IMAGE_MAX_BYTES=5242880

# For local development only.
# Production EC2 should use an IAM role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=